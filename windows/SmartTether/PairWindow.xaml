<Window x:Class="SmartTether.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair a phone" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20" Width="300">
        <TextBlock Text="Pair a phone" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="Scan this code in the Smart Tether app."
                   TextTrimming="CharacterEllipsis" Margin="0,6,0,16" FontSize="13"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Border Background="White" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <Button Content="Close" HorizontalAlignment="Right" MinWidth="96" Margin="0,20,0,0"
                IsCancel="True" IsDefault="True" Click="Close_Click" />
    </StackPanel>
</Window>
